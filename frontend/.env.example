VITE_API_URL=/api/v1
# Development server proxy only; deployed frontend normally uses a same-origin reverse proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_GOOGLE_CLIENT_ID=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_PROVIDER_NAME=OpenFreeMap
VITE_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors
VITE_INITIAL_LONGITUDE=28.0473
VITE_INITIAL_LATITUDE=-26.2041
# Must be false in production. The backend independently rejects production bypasses.
VITE_ENABLE_DEV_AUTH=false
