{
  "name": "@mapsafe/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/require-test-db.mjs && vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@turf/turf": "7.2.0",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "10.3.0",
    "helmet": "8.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "5.22.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
